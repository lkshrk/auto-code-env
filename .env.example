# Copy to .env and adjust for the Windows host running Docker Desktop.
AUTO_CODE_IMAGE=ghcr.io/example/auto-code-env:dev-both-sha-0123456789ab
AUTO_CODE_SSH_BIND=192.0.2.10
AUTO_CODE_SSH_PORT=2222

# Public key only. Keep the matching private key on the SSH client.
AUTO_CODE_AUTHORIZED_KEYS_FILE=C:/Users/example/.ssh/id_ed25519.pub

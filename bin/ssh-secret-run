#!/bin/sh
set -eu

key=${AUTO_CODE_SSH_KEY_FILE:-/run/secrets/ssh_key}
[ -f "$key" ] || { echo "ssh-secret-run: key not found: $key" >&2; exit 1; }
[ "$#" -gt 0 ] || set -- "${SHELL:-/usr/bin/zsh}" -l

exec ssh-agent /bin/bash -c '
  set -euo pipefail
  key=$1
  shift
  sudo -n cat "$key" | ssh-add -
  exec "$@"
' bash "$key" "$@"

#!/bin/sh
set -eu

/usr/local/bin/auto-code-env-dots
sudo install -d -o "$(id -u)" -g "$(id -g)" -m 0700 "$XDG_RUNTIME_DIR"
if [ -f "$HOME/.config/omni/settings.json" ]; then
  export OMNI_CONFIG="$HOME/.config/omni/settings.json"
else
  export OMNI_CONFIG="${OMNI_CONFIG:-/opt/dotfiles/dotfiles/omni/.config/omni/settings.json}"
fi
[ "${AUTO_CODE_SSHD:-0}" != 1 ] || /usr/local/bin/auto-code-sshd start
exec "$@"

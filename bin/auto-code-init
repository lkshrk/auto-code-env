#!/usr/bin/env bash
set -euo pipefail

dotfiles_source=${AUTO_CODE_DOTFILES_SOURCE:-/opt/dotfiles}
run_dir=${AUTO_CODE_RUN_DIR:-/run/auto-code-env}
runtime_dir=${XDG_RUNTIME_DIR:-/run/user/1000}
state_dir=$HOME/.local/state/auto-code-env
dotfiles_dir=$HOME/dotfiles
workspace_dir=$HOME/workspace
ready_file=$run_dir/ready

fail() { printf 'auto-code-init: %s\n' "$*" >&2; exit 1; }

[[ $(id -u) == 1000 && $HOME == /home/dev ]] || [[ -n ${AUTO_CODE_DOTFILES_SOURCE:-} ]] \
  || fail 'expected dev uid 1000 with HOME=/home/dev'
[[ -d $HOME && -w $HOME ]] || fail "home is not writable: $HOME"
[[ -d $dotfiles_source/.git ]] || fail "pinned dotfiles checkout missing: $dotfiles_source"

if ! install -d -m 0700 "$run_dir" 2>/dev/null; then
  sudo install -d -o "$(id -u)" -g "$(id -g)" -m 0700 "$run_dir"
fi
if ! install -d -m 0700 "$runtime_dir" 2>/dev/null; then
  sudo install -d -o "$(id -u)" -g "$(id -g)" -m 0700 "$runtime_dir"
fi
install -d -m 0700 "$state_dir" "$workspace_dir"

exec 9>"$state_dir/init.lock"
flock 9
rm -f "$ready_file"

if [[ ! -e $dotfiles_dir ]]; then
  seed=$(mktemp -d "$HOME/.dotfiles-seed.XXXXXX")
  trap 'rm -rf "${seed:-}"' EXIT
  cp -a "$dotfiles_source/." "$seed/"
  mv "$seed" "$dotfiles_dir"
  seed=
elif [[ ! -d $dotfiles_dir/.git ]]; then
  fail "existing dotfiles path is not a Git checkout: $dotfiles_dir"
fi

config=$dotfiles_dir/dotfiles/omni/.config/omni/settings.json
volatile=$dotfiles_dir/scripts/volatile-dots.sh
[[ -r $config && -x $volatile ]] || fail 'dotfiles checkout lacks Omni config or volatile-dots helper'

cleanup_dots() { "$volatile" detach; }
trap cleanup_dots EXIT
"$volatile" prepare
OMNI_HOSTNAME=auto-code omni --config "$config" --yes dots sync --use-repo
cleanup_dots
trap - EXIT

[[ -L $HOME/.config/omni/settings.json && -L $HOME/.zshrc ]] \
  || fail 'required dotfiles were not linked'

if [[ ${AUTO_CODE_REQUIRE_DOCKER:-0} == 1 ]]; then
  docker info >/dev/null || fail 'Docker daemon is required but unavailable'
fi

ready_tmp=$(mktemp "$run_dir/.ready.XXXXXX")
printf 'ready=1\ninit_abi=1\ndotfiles=%s\n' "$(git -C "$dotfiles_dir" rev-parse HEAD 2>/dev/null || printf unknown)" > "$ready_tmp"
chmod 0600 "$ready_tmp"
mv -f "$ready_tmp" "$ready_file"

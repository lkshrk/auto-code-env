#!/bin/sh
set -eu

[ "$#" -gt 0 ] || { echo "usage: rbw-ssh-shell <item selector> [command ...]" >&2; exit 2; }
item=$1
shift
[ "$#" -gt 0 ] || set -- "${SHELL:-/usr/bin/zsh}" -l

exec ssh-agent /bin/bash -c '
  set -euo pipefail
  item=$1
  shift
  rbw unlock >/dev/null
  trap "rbw lock >/dev/null 2>&1 || true" EXIT
  rbw get --field=private_key "$item" | ssh-add -
  "$@"
' bash "$item" "$@"

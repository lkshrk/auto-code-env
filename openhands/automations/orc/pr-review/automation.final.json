{
  "name": "pr-review",
  "model": "gpt-6-astra",
  "timeout": 900,
  "keep_alive": false,
  "enabled": true,
  "trigger": {
    "type": "event",
    "source": "github",
    "on": [
      "pull_request.opened",
      "pull_request.synchronize",
      "pull_request.ready_for_review",
      "pull_request.reopened",
      "issue_comment.created"
    ],
    "filter": "(pull_request && !(pull_request.draft) && sender.type != 'Bot') || (comment && issue.pull_request && sender.type != 'Bot' && icontains(comment.body, '@openhands review'))"
  }
}

#!/bin/sh
# shellcheck disable=SC2016
set -eu

PINENTRY=/usr/local/libexec/openhands-rbw-pinentry
TLS_DIRECTORY=/etc/nginx/tls
TLS_CERTIFICATE="$TLS_DIRECTORY/tls.crt"
TLS_KEY="$TLS_DIRECTORY/tls.key"
CREDSTORE=/etc/credstore
BACKEND_KEY="$CREDSTORE/local_backend_api_key"
MASTER_PASSWORD_FILE=/run/openhands-rbw-master
WORK_DIRECTORY=/run/openhands-overlay
SERVICE_DROPIN=/etc/systemd/system/agent-canvas.service.d/10-overlay.conf
RELEASE_MARKER=/etc/openhands/release
RBW_CONFIG=/root/.config/rbw/config.json
AGENT_HOME=/home/agent
GIT_CREDENTIALS=/home/agent/.git-credentials
INGRESS=http://127.0.0.1:8000
CA_CERTIFICATE=/usr/local/share/ca-certificates/openhands-lan-ca.crt
STATE_DIRECTORY=/var/lib/openhands/overlay
GIT_SYNC_TOKEN_STATE="$STATE_DIRECTORY/git-sync-token.sha256"
APPLIER=/usr/local/lib/openhands/apply-profile.py
STATE_PATHS='home/agent/.openhands home/agent/.claude home/agent/.codex home/agent/.git-credentials home/agent/.gitconfig var/lib/openhands/overlay'
PASSWORD_STDIN=0

usage() {
    cat >&2 <<'EOF'
usage: openhands-overlay secrets --vault-url URL --email EMAIL --crt-id UUID --key-id UUID --api-id UUID [--password-stdin]
       openhands-overlay github --pat-id UUID [--vault-url URL --email EMAIL] [--password-stdin]
       openhands-overlay ca --item UUID [--vault-url URL --email EMAIL] [--password-stdin]
       openhands-overlay settings --file PATH [--file PATH ...] [--password-stdin]
       openhands-overlay state export > state.tar.gz
       openhands-overlay state import < state.tar.gz
       openhands-overlay origin https://canvas.example [https://other.example ...]
       openhands-overlay verify
       openhands-overlay enable
       openhands-overlay status
       openhands-overlay egress [--minutes N] [--interval SECONDS] [--from FILE]

Repeating --file layers profiles left to right: later files win per key, and
map-shaped sections (skills, secrets, mcp_servers) are merged rather than
replaced.

--password-stdin reads the Vaultwarden master password from stdin instead of
asking for it interactively.
EOF
    exit 2
}

fail() {
    printf 'openhands-overlay: %s\n' "$1" >&2
    exit 1
}

cleanup() {
    rm -f "$MASTER_PASSWORD_FILE"
    rm -rf "$WORK_DIRECTORY"
}

require_root() {
    [ "$(id -u)" = 0 ] || fail 'must run as root'
}

is_uuid() {
    printf '%s' "$1" | grep -Eq '^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$'
}

configure_rbw() {
    vault_url=$1 email=$2
    if [ -z "$vault_url" ] && [ -z "$email" ]; then
        [ -f "$RBW_CONFIG" ] || fail 'rbw is not configured yet; pass --vault-url and --email'
        return
    fi
    case $vault_url in https://*) ;; *) fail 'vault URL must be absolute HTTPS' ;; esac
    [ -n "$email" ] || fail 'email is required'
    [ -x "$PINENTRY" ] || fail 'image pinentry missing'
    umask 077
    mkdir -p "$(dirname "$RBW_CONFIG")"
    rbw config set base_url "$vault_url"
    rbw config set email "$email"
    rbw config set pinentry "$PINENTRY"
    rbw config set lock_timeout 300
}

read_master_password() {
    umask 077
    if [ "$PASSWORD_STDIN" = 1 ]; then
        head -n 1 | tr -d '\r\n' > "$MASTER_PASSWORD_FILE"
    else
        systemd-ask-password --echo=no 'Vaultwarden master password:' | tr -d '\n' > "$MASTER_PASSWORD_FILE"
    fi
    [ -s "$MASTER_PASSWORD_FILE" ] || fail 'empty master password'
}

# vault_run ENV_ASSIGNMENT... -- SCRIPT
# Runs SCRIPT as root inside one transient unit with an unlocked rbw; the master
# password lives only in a root tmpfs file for the duration.
vault_run() {
    set -- "$@"
    env_args=""
    while [ $# -gt 0 ]; do
        case $1 in
            --) shift; break ;;
            *) env_args="$env_args -E $1"; shift ;;
        esac
    done
    [ $# -eq 1 ] || fail 'vault_run needs exactly one script'
    read_master_password
    # shellcheck disable=SC2086
    systemd-run --quiet --pipe --wait --collect \
        -E HOME=/root -E USER=root $env_args \
        -E OVERLAY_SCRIPT="$1" \
        -p "LoadCredential=rbw_master:$MASTER_PASSWORD_FILE" \
        /bin/sh -eu -c 'umask 077; rbw login; rbw sync; sh -eu -c "$OVERLAY_SCRIPT"; rbw lock; rbw stop-agent; rbw purge'
    rm -f "$MASTER_PASSWORD_FILE"
}

secrets() {
    vault_url='' email='' crt_id='' key_id='' api_id=''
    while [ $# -gt 0 ]; do
        case $1 in
            --vault-url) vault_url=${2:-}; shift 2 ;;
            --email) email=${2:-}; shift 2 ;;
            --crt-id) crt_id=${2:-}; shift 2 ;;
            --key-id) key_id=${2:-}; shift 2 ;;
            --api-id) api_id=${2:-}; shift 2 ;;
            --password-stdin) PASSWORD_STDIN=1; shift ;;
            *) usage ;;
        esac
    done
    for id in "$crt_id" "$key_id" "$api_id"; do
        is_uuid "$id" || fail 'item ids must be lowercase UUIDs'
    done
    configure_rbw "$vault_url" "$email"
    vault_run "OVERLAY_CRT_ID=$crt_id" "OVERLAY_KEY_ID=$key_id" "OVERLAY_API_ID=$api_id" -- '
        install -d -o root -g root -m 0755 /etc/nginx/tls
        install -d -o root -g root -m 0700 /etc/credstore
        rbw get --field notes "$OVERLAY_CRT_ID" > /etc/nginx/tls/tls.crt
        rbw get --field notes "$OVERLAY_KEY_ID" > /etc/nginx/tls/tls.key
        rbw get "$OVERLAY_API_ID" | tr -d "\n" > /etc/credstore/local_backend_api_key
        chown root:root /etc/nginx/tls/tls.crt /etc/nginx/tls/tls.key /etc/credstore/local_backend_api_key
        chmod 0644 /etc/nginx/tls/tls.crt
        chmod 0600 /etc/nginx/tls/tls.key /etc/credstore/local_backend_api_key
    '
    verify
}

github() {
    vault_url='' email='' pat_id=''
    while [ $# -gt 0 ]; do
        case $1 in
            --vault-url) vault_url=${2:-}; shift 2 ;;
            --email) email=${2:-}; shift 2 ;;
            --pat-id) pat_id=${2:-}; shift 2 ;;
            --password-stdin) PASSWORD_STDIN=1; shift ;;
            *) usage ;;
        esac
    done
    is_uuid "$pat_id" || fail '--pat-id must be a lowercase UUID'
    id agent >/dev/null 2>&1 || fail 'agent user missing'
    configure_rbw "$vault_url" "$email"
    vault_run "OVERLAY_PAT_ID=$pat_id" "OVERLAY_GIT_CREDENTIALS=$GIT_CREDENTIALS" -- '
        token=$(rbw get "$OVERLAY_PAT_ID" | tr -d "\n")
        [ -n "$token" ] || { echo "empty GitHub token" >&2; exit 1; }
        printf "https://x-access-token:%s@github.com\n" "$token" > "$OVERLAY_GIT_CREDENTIALS.tmp"
        chown agent:agent "$OVERLAY_GIT_CREDENTIALS.tmp"
        chmod 0600 "$OVERLAY_GIT_CREDENTIALS.tmp"
        mv -f "$OVERLAY_GIT_CREDENTIALS.tmp" "$OVERLAY_GIT_CREDENTIALS"
    '
    runuser -u agent -- env HOME="$AGENT_HOME" git config --global credential.helper store
    [ "$(stat -c '%U:%G %a' "$GIT_CREDENTIALS")" = 'agent:agent 600' ] || fail 'wrong owner or mode on git credentials'
    echo 'github credential installed for agent'
}

ca() {
    vault_url='' email='' item=''
    while [ $# -gt 0 ]; do
        case $1 in
            --vault-url) vault_url=${2:-}; shift 2 ;;
            --email) email=${2:-}; shift 2 ;;
            --item) item=${2:-}; shift 2 ;;
            --password-stdin) PASSWORD_STDIN=1; shift ;;
            *) usage ;;
        esac
    done
    is_uuid "$item" || fail '--item must be a lowercase UUID'
    configure_rbw "$vault_url" "$email"
    install -d -o root -g root -m 0755 "$(dirname "$CA_CERTIFICATE")"
    vault_run "OVERLAY_CA_ID=$item" "OVERLAY_CA_FILE=$CA_CERTIFICATE" -- '
        rbw get --field notes "$OVERLAY_CA_ID" > "$OVERLAY_CA_FILE.tmp"
        grep -q "BEGIN CERTIFICATE" "$OVERLAY_CA_FILE.tmp" || {
            rm -f "$OVERLAY_CA_FILE.tmp"
            echo "vault item does not hold a PEM certificate" >&2
            exit 1
        }
        chown root:root "$OVERLAY_CA_FILE.tmp"
        chmod 0644 "$OVERLAY_CA_FILE.tmp"
        mv -f "$OVERLAY_CA_FILE.tmp" "$OVERLAY_CA_FILE"
    '
    update-ca-certificates >/dev/null
    printf 'ca installed %s\n' "$CA_CERTIFICATE"
}

# agent_run DIRECTORY COMMAND... - runs COMMAND as the agent user in DIRECTORY.
agent_run() {
    directory=$1
    shift
    runuser -u agent -- env HOME="$AGENT_HOME" USER=agent LOGNAME=agent \
        PATH="$AGENT_HOME/.local/bin:$PATH" \
        sh -eu -c 'cd "$1"; shift; exec "$@"' sh "$directory" "$@"
}

# prune_apm_mcp - drops harness MCP entries whose ${env:NAME} no harness expands.
prune_apm_mcp() {
    [ -d "$AGENT_HOME" ] || return 0
    agent_run "$AGENT_HOME" python3 - "$AGENT_HOME" <<'PYTHON'
import json, os, re, sys

home = sys.argv[1]
placeholder = "${env:"
removed = []

claude = os.path.join(home, ".claude.json")
try:
    with open(claude) as handle:
        data = json.load(handle)
except (OSError, ValueError):
    data = None
if isinstance(data, dict):
    servers = data.get("mcpServers")
    if isinstance(servers, dict):
        stale = [
            name for name, spec in servers.items()
            if placeholder in json.dumps(spec)
        ]
        for name in stale:
            del servers[name]
            removed.append("claude:%s" % name)
        if stale:
            with open(claude, "w") as handle:
                json.dump(data, handle, indent=2)

codex = os.path.join(home, ".codex", "config.toml")
try:
    with open(codex) as handle:
        text = handle.read()
except OSError:
    text = None
if text is not None and placeholder in text:
    blocks, current = [], []
    for line in text.splitlines(True):
        if line.startswith("[") and current:
            blocks.append(current)
            current = []
        current.append(line)
    if current:
        blocks.append(current)

    def server_of(block):
        match = re.match(r"^\[mcp_servers\.([A-Za-z0-9._-]+?)(?:\.[A-Za-z0-9._-]+)*\]", block[0])
        return match.group(1) if match else None

    poisoned = {
        server_of(block)
        for block in blocks
        if server_of(block) and placeholder in "".join(block)
    }
    if poisoned:
        kept = [b for b in blocks if server_of(b) not in poisoned]
        with open(codex, "w") as handle:
            handle.write("".join("".join(b) for b in kept))
        removed.extend("codex:%s" % name for name in sorted(poisoned))

print("apm mcp pruned: %s" % (", ".join(removed) if removed else "none"))
PYTHON
}

settings() {
    files=''
    while [ $# -gt 0 ]; do
        case $1 in
            --file)
                profile=${2:-}
                [ -n "$profile" ] || usage
                [ -r "$profile" ] || fail "unreadable profile $profile"
                case $profile in *[[:space:]]*) fail "profile path must not contain whitespace: $profile" ;; esac
                files="$files $profile"
                shift 2 ;;
            --password-stdin) PASSWORD_STDIN=1; shift ;;
            *) usage ;;
        esac
    done
    [ -n "$files" ] || usage
    command -v python3 >/dev/null 2>&1 || fail 'python3 is required'
    [ -x "$APPLIER" ] || fail "missing $APPLIER"
    [ -r "$BACKEND_KEY" ] || fail "missing $BACKEND_KEY"

    # shellcheck disable=SC2086
    items=$("$APPLIER" --print secret-items $files)
    umask 077
    rm -rf "$WORK_DIRECTORY"
    install -d -o root -g root -m 0700 "$WORK_DIRECTORY"
    if [ -n "$items" ]; then
        configure_rbw '' ''
        printf '%s\n' "$items" > "$WORK_DIRECTORY/items"
        vault_run "OVERLAY_WORK=$WORK_DIRECTORY" -- '
            while read -r name item; do
                rbw get "$item" | tr -d "\n" > "$OVERLAY_WORK/$name"
                [ -s "$OVERLAY_WORK/$name" ] || { echo "empty vault item" >&2; exit 1; }
                chmod 0600 "$OVERLAY_WORK/$name"
            done < "$OVERLAY_WORK/items"
            rm -f "$OVERLAY_WORK/items"
        '
    fi
    # shellcheck disable=SC2086
    "$APPLIER" --api "$INGRESS" --api-key-file "$BACKEND_KEY" \
        --secrets-dir "$WORK_DIRECTORY" --state-dir "$STATE_DIRECTORY" $files
    rm -rf "$WORK_DIRECTORY"
    prune_apm_mcp
}

state() {
    [ $# -eq 1 ] || usage
    case $1 in
        export) state_export ;;
        import) state_import ;;
        *) usage ;;
    esac
}

state_export() {
    set --
    for path in $STATE_PATHS; do
        if [ -e "/$path" ]; then set -- "$@" "$path"; fi
    done
    [ $# -gt 0 ] || fail 'no agent state to export'
    for path in "$@"; do
        printf 'export /%s\n' "$path" >&2
    done
    tar --numeric-owner --create --gzip --file - --directory / -- "$@"
}

state_import() {
    id agent >/dev/null 2>&1 || fail 'agent user missing'
    tar --numeric-owner --extract --gzip --file - --directory /
    for path in $STATE_PATHS; do
        if [ -e "/$path" ]; then
            case $path in
                home/agent/*) chown -R agent:agent "/$path" ;;
                *) chown -R root:root "/$path" ;;
            esac
            printf 'import /%s\n' "$path"
        fi
    done
    for directory in "$AGENT_HOME/.openhands" "$AGENT_HOME/.claude" "$AGENT_HOME/.codex"; do
        if [ -d "$directory" ]; then chmod 0700 "$directory"; fi
    done
    if [ -d "$STATE_DIRECTORY" ]; then chmod 0700 "$STATE_DIRECTORY"; fi
    if [ -f "$GIT_SYNC_TOKEN_STATE" ]; then chmod 0600 "$GIT_SYNC_TOKEN_STATE"; fi
    if [ -f "$GIT_CREDENTIALS" ]; then chmod 0600 "$GIT_CREDENTIALS"; fi
    echo 'state imported'
}

assert_file() {
    path=$1 mode=$2
    [ -f "$path" ] || fail "missing $path"
    [ "$(stat -c '%U:%G %a' "$path")" = "root:root $mode" ] || fail "wrong owner or mode on $path"
}

verify() {
    assert_file "$TLS_CERTIFICATE" 644
    assert_file "$TLS_KEY" 600
    assert_file "$BACKEND_KEY" 600
    [ "$(stat -c '%U:%G %a' "$CREDSTORE")" = 'root:root 700' ] || fail "wrong owner or mode on $CREDSTORE"
    subject=$(openssl x509 -in "$TLS_CERTIFICATE" -noout -subject) || fail 'unreadable certificate'
    certificate_key=$(openssl x509 -in "$TLS_CERTIFICATE" -noout -pubkey) || fail 'unreadable certificate public key'
    private_key=$(openssl pkey -in "$TLS_KEY" -pubout) || fail 'unreadable private key'
    [ "$certificate_key" = "$private_key" ] || fail 'private key does not match certificate'
    [ "$(wc -c < "$BACKEND_KEY")" -ge 32 ] || fail 'backend key shorter than 32 bytes'
    nginx -t >/dev/null 2>&1 || fail 'nginx configuration test failed'
    printf 'tls: %s\n' "$subject"
    openssl x509 -in "$TLS_CERTIFICATE" -noout -enddate
    printf 'backend key: %s bytes\n' "$(wc -c < "$BACKEND_KEY")"
    echo 'overlay verified'
}

enable_services() {
    verify
    systemctl enable --now nginx.service agent-canvas.service openhands-run-prune.timer
    status
}

origin() {
    [ $# -ge 1 ] || usage
    for value in "$@"; do
        printf '%s' "$value" | grep -Eq '^https://[A-Za-z0-9.-]+(:[0-9]+)?$' || fail "origin must be https://host[:port] without a path: $value"
    done
    umask 022
    install -d -o root -g root -m 0755 "$(dirname "$SERVICE_DROPIN")"
    {
        echo '[Service]'
        index=0
        for value in "$@"; do
            printf 'Environment=OH_ALLOW_CORS_ORIGINS_%s=%s\n' "$index" "$value"
            index=$((index + 1))
        done
    } > "$SERVICE_DROPIN"
    chown root:root "$SERVICE_DROPIN"
    chmod 0644 "$SERVICE_DROPIN"
    systemctl daemon-reload
    systemctl try-restart agent-canvas.service
    for value in "$@"; do
        printf 'origin %s\n' "$value"
    done
}

egress() {
    minutes=10 interval=5 source=''
    while [ $# -gt 0 ]; do
        case $1 in
            --minutes) minutes=${2:-}; shift 2 ;;
            --interval) interval=${2:-}; shift 2 ;;
            --from) source=${2:-}; shift 2 ;;
            *) usage ;;
        esac
    done
    printf '%s' "$minutes$interval" | grep -Eq '^[0-9]+$' || fail 'minutes and interval must be integers'
    /usr/bin/python3 - "$minutes" "$interval" "$source" <<'PYTHON'
import ipaddress, socket, sys, time
from collections import Counter

minutes, interval, source = int(sys.argv[1]), int(sys.argv[2]), sys.argv[3]
ESTABLISHED = "01"

def decode(addr, family):
    host, port = addr.split(":")
    if family == 4:
        ip = ipaddress.ip_address(bytes.fromhex(host)[::-1])
    else:
        raw = bytes.fromhex(host)
        ip = ipaddress.ip_address(b"".join(raw[i:i + 4][::-1] for i in range(0, 16, 4)))
        if ip.ipv4_mapped:
            ip = ip.ipv4_mapped
    return ip, int(port, 16)

def sample(lines):
    for line in lines:
        fields = line.split()
        if len(fields) < 4 or fields[3] != ESTABLISHED:
            continue
        family = 6 if len(fields[2].split(":")[0]) == 32 else 4
        remote, port = decode(fields[2], family)
        if remote.is_loopback or remote.is_link_local or remote.is_unspecified:
            continue
        yield str(remote), port

seen = Counter()
if source:
    with open(source) as handle:
        seen.update(sample(handle.read().splitlines()))
else:
    deadline = time.time() + minutes * 60
    while True:
        for path in ("/proc/net/tcp", "/proc/net/tcp6"):
            try:
                with open(path) as handle:
                    seen.update(sample(handle.read().splitlines()[1:]))
            except OSError:
                pass
        if time.time() >= deadline:
            break
        time.sleep(interval)

def scope(ip):
    address = ipaddress.ip_address(ip)
    return "lan" if address.is_private else "internet"

def name(ip):
    try:
        return socket.gethostbyaddr(ip)[0]
    except OSError:
        return "-"

print("scope destination port samples name")
for (ip, port), count in sorted(seen.items(), key=lambda item: (scope(item[0][0]), item[0])):
    print(f"{scope(ip)} {ip} {port} {count} {name(ip)}")
PYTHON
}

status() {
    if [ -r "$RELEASE_MARKER" ]; then
        printf 'release %s\n' "$(cat "$RELEASE_MARKER")"
    else
        echo 'release unknown (no marker)'
    fi
    systemctl is-active nginx.service agent-canvas.service || true
    cat /proc/net/tcp /proc/net/tcp6 2>/dev/null | while read -r _ local _ state _; do
        [ "$state" = 0A ] && printf 'listen %s:%d\n' "${local%:*}" "0x${local#*:}"
    done | sort -u
}

require_root
trap cleanup EXIT INT TERM
command=${1:-}
[ $# -gt 0 ] && shift
case $command in
    secrets) secrets "$@" ;;
    github) github "$@" ;;
    ca) ca "$@" ;;
    settings) settings "$@" ;;
    state) state "$@" ;;
    verify) [ $# -eq 0 ] || usage; verify ;;
    enable) [ $# -eq 0 ] || usage; enable_services ;;
    origin) origin "$@" ;;
    status) [ $# -eq 0 ] || usage; status ;;
    egress) egress "$@" ;;
    *) usage ;;
esac

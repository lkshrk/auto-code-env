{
  "secrets": {
    "LITELLM_API": {
      "item": "e11c580d-59d0-4b50-a932-bcde5c4e1b57",
      "prefix": "Bearer "
    },
    "CODER_SESSION_TOKEN": {
      "item": "00000000-0000-0000-0000-000000000000"
    }
  },
  "skills": [
    {
      "source": "https://github.com/lkshrk/auto-code-env.git",
      "ref": "main",
      "repo_path": "openhands/skills/agent-sandbox-deploy"
    },
    {
      "source": "https://github.com/lkshrk/auto-code-env.git",
      "ref": "main",
      "repo_path": "openhands/skills/coder-workspaces"
    }
  ],
  "mcp_servers": {
    "coder": {
      "command": "coder",
      "args": [
        "exp",
        "mcp",
        "server",
        "--allowed-tools",
        "coder_get_authenticated_user,coder_list_templates,coder_get_template,coder_list_workspaces,coder_get_workspace,coder_create_workspace,coder_create_workspace_build,coder_get_workspace_build_logs,coder_get_workspace_agent_logs,coder_workspace_bash,coder_workspace_ls,coder_workspace_read_file,coder_workspace_write_file,coder_workspace_edit_file,coder_workspace_list_apps"
      ],
      "env": {
        "CODER_URL": "https://coder.h-cloud.io",
        "CODER_DISABLE_TELEMETRY": "true",
        "CODER_SESSION_TOKEN": {
          "secret": "CODER_SESSION_TOKEN"
        }
      }
    },
    "litellm-tools": {
      "url": "https://api.ai.h-cloud.lan/mcp/",
      "headers": {
        "x-litellm-api-key": {
          "secret": "LITELLM_API"
        }
      }
    },
    "openaiDeveloperDocs": {
      "url": "https://developers.openai.com/mcp"
    }
  }
}

# hermes-hq control-hub: sample environment file
#
# NOT consumed directly by the image - the running pod gets these as
# plain env vars from a SOPS-encrypted Kubernetes Secret in lkshrk/h-cloud
# (same pattern every other app in the cluster uses: openviking, phoenix,
# litellm-proxy, vaultwarden itself). This file exists purely as a
# reference for what that Secret's keys need to be. See
# docs/secrets-checklist.md for the full rationale, including why rbw and
# Bitwarden Secrets Manager were both considered and rejected for this pod.
#
# Copy this file, fill in real values, and use it to build the h-cloud
# SOPS secret - never commit a filled-in copy anywhere.

# ── Real secrets ─────────────────────────────────────────────────────────

# LiteLLM proxy auth - primary + fallback chat model routing.
HERMES_CUSTOM_API_AI_H_CLOUD_LAN_API_KEY=

# Image generation only (image_gen.provider: openrouter,
# google/gemini-3-pro-image). Chat models route through LiteLLM instead -
# this key has no other purpose in this image.
OPENROUTER_API_KEY=

# Signal messaging gateway. SIGNAL_ACCOUNT is the registered phone number
# and is itself sensitive, not just a lookup key.
SIGNAL_ACCOUNT=
SIGNAL_ALLOWED_USERS=
SIGNAL_GROUP_ALLOWED_USERS=
SIGNAL_HOME_CHANNEL=
SIGNAL_HOME_CHANNEL_NAME=

# NOT YET PROVISIONED (see docs/secrets-checklist.md "Known gaps"):
#
# Dedicated GitHub identity (not lkshrk's own account) for git push/PR
# ops, scoped to repo+workflow on dotfiles/hermes-hq/h-cloud. Blocked on
# collaborator access being granted to that identity.
GITHUB_TOKEN=
#
# Dedicated `hermes-agent` Coder user's session token - create/manage/ssh
# into hermes-worker-js/py/go workspaces. Coder user does not exist yet.
CODER_SESSION_TOKEN=
#
# OpenViking memory backend auth. This session uses a file-based config
# (~/.openviking/ovcli.conf.hermes), not an env var - hermes-hq needs its
# own actor/API key (do not reuse this session's key for a second running
# instance) or the equivalent conf file mounted in.
OPENVIKING_API_KEY=

# ── Non-secret config ────────────────────────────────────────────────────
# Fine to bake into the Containerfile or the HelmRelease's plain `env:`
# block directly - listed here only so the full env surface is visible
# in one place.

CAMOFOX_URL=
# This session's actual value (http://localhost:9377) is a LOCAL camofox
# instance, not an in-cluster service - it will NOT work as-is inside the
# hermes-hq pod. Needs either a real in-cluster camofox Service/HTTPRoute
# to point at, or camofox running as a sidecar in the same pod. Not yet
# resolved - flagging rather than guessing at a URL.
SEARXNG_URL=https://search.ai.h-coud.lan
# Note: "h-coud" (not "h-cloud") is the real hostname in this session's
# live config - verified against ~/.hermes/.env, not a typo introduced
# here. Confirm whether that's intentional before reusing it.
SIGNAL_HTTP_URL=http://signal-rest-api.tools.svc.cluster.local

# Only relevant if Browserbase is actually used - current config has
# browser.cloud_provider: camofox. BROWSERBASE_PROXIES=true is set in
# this session despite that (verified against ~/.hermes/.env) - unclear
# if intentional or leftover; confirm before dropping.
BROWSERBASE_ADVANCED_STEALTH=false
BROWSERBASE_PROXIES=true

BROWSER_INACTIVITY_TIMEOUT=120
BROWSER_SESSION_TIMEOUT=300

# Only relevant if terminal.backend uses Modal - current config has
# terminal.backend: local, so TERMINAL_MODAL_IMAGE is likely dead weight
# (its value here is just this session's leftover default image ref).
TERMINAL_LIFETIME_SECONDS=300
TERMINAL_TIMEOUT=60
TERMINAL_MODAL_IMAGE=nikolaik/python-nodejs:python3.11-nodejs20

# Debug flags - default false, leave as-is unless actively debugging.
IMAGE_TOOLS_DEBUG=false
MOA_TOOLS_DEBUG=false
VISION_TOOLS_DEBUG=false
WEB_TOOLS_DEBUG=false

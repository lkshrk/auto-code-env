ARG OPENHANDS_WORKER_VERSION=dev
FROM ubuntu:26.04@sha256:2260313b31c8c011cd2eebe728008efac1b3982be73eb71348ea2648d2c0e09b AS provisioned
ARG OPENHANDS_WORKER_VERSION

RUN test "$(/usr/bin/getent passwd ubuntu)" = 'ubuntu:x:1000:1000:Ubuntu:/home/ubuntu:/bin/bash' && \
    test "$(/usr/bin/getent group ubuntu)" = 'ubuntu:x:1000:' && \
    /usr/sbin/userdel -r ubuntu && \
    ! /usr/bin/getent passwd ubuntu && ! /usr/bin/getent group ubuntu && ! -e /home/ubuntu

COPY --chown=root:root worker/provision.sh worker/rootfs-wsl/etc/wsl.conf worker/patches/patch-agent-canvas-automation.mjs worker/tests/agent-canvas-ingress-smoke.mjs /opt/openhands-build/
COPY --chown=root:root worker/omni/settings.json /opt/openhands-build/omni/settings.json
RUN OPENHANDS_IMAGE_BUILD=1 /bin/bash /opt/openhands-build/provision.sh && \
    /usr/bin/rm -f /etc/nginx/sites-enabled/default && \
    /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin UV_CACHE_DIR=/home/agent/.cache/uv \
      /usr/local/bin/uvx --from openhands-agent-server==1.44.0 --with openhands-sdk==1.44.0 --with openhands-tools==1.44.0 --with openhands-workspace==1.44.0 --with 'agent-client-protocol<0.11' --with 'posthog>=6,<7' agent-server --import-modules canvas_ui_tool --help >/dev/null && \
    /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin \
      /usr/local/bin/node /opt/openhands-build/patch-agent-canvas-automation.mjs /home/agent/.local/lib/node_modules/@openhands/agent-canvas/scripts/dev-with-automation.mjs && \
    /usr/local/bin/node --check /home/agent/.local/lib/node_modules/@openhands/agent-canvas/scripts/dev-with-automation.mjs && \
    /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin \
      /usr/local/bin/node /opt/openhands-build/patch-agent-canvas-automation.mjs /home/agent/.local/lib/node_modules/@openhands/agent-canvas/scripts/ingress.mjs && \
    /usr/local/bin/node --check /home/agent/.local/lib/node_modules/@openhands/agent-canvas/scripts/ingress.mjs && \
    /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin UV_CACHE_DIR=/home/agent/.cache/uv \
      /usr/local/bin/uv run --no-project --with openhands-automation==1.9.0 python -m uvicorn openhands.automation.app:app --help >/dev/null && \
    test "$(/usr/bin/id -u agent)" = 1000 && test "$(/usr/bin/id -g agent)" = 1000 && \
    /usr/bin/install -d -o root -g root -m 0755 /etc/openhands && \
    printf "openhands-worker %s\n" "$OPENHANDS_WORKER_VERSION" > /etc/openhands/release && \
    /usr/bin/chmod 0644 /etc/openhands/release && \
    /usr/bin/rm -rf /var/lib/apt/lists/*

COPY --chown=root:root worker/rootfs/ /

FROM provisioned AS oci

COPY --chown=root:root worker/rootfs-oci/ /
RUN /usr/bin/chmod 0755 /usr/local/sbin/container-entrypoint && /usr/bin/install -d -o root -g root -m 0755 /etc/nginx/tls
EXPOSE 443
ENTRYPOINT ["/usr/local/sbin/container-entrypoint"]

FROM oci AS smoke

RUN test "$(/usr/bin/id -u agent)" = 1000 && test "$(/usr/bin/id -g agent)" = 1000 && \
    test "$(/usr/bin/id -nG agent)" = agent && ! /usr/bin/id -nG agent | /usr/bin/grep -qw sudo && [ ! -x /usr/bin/sudo ] && \
    test "$(/usr/local/bin/node --version)" = v24.20.0 && test "$(/usr/local/bin/npm --version)" = 11.19.0 && \
    case "$(/usr/local/bin/uv --version)" in 'uv 0.12.7 ('*) ;; *) exit 1;; esac && \
    case "$(/usr/local/bin/uvx --version)" in 'uvx 0.12.7 ('*) ;; *) exit 1;; esac && \
    installed=$(/usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin NPM_CONFIG_USERCONFIG=/dev/null NPM_CONFIG_GLOBALCONFIG=/etc/openhands/npmrc /usr/local/bin/npm --prefix /home/agent/.local --cache /home/agent/.cache/npm --global --depth=0 --json ls) && \
    /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin /usr/local/bin/node -e 'const expected = {"@openhands/agent-canvas":"1.16.0","@agentclientprotocol/claude-agent-acp":"0.63.0","@agentclientprotocol/codex-acp":"1.1.7","@anthropic-ai/claude-code":"2.1.251","@openai/codex":"0.151.0"}; const actual = JSON.parse(process.argv[1]).dependencies || {}; process.exit(Object.keys(actual).length === Object.keys(expected).length && Object.entries(expected).every(([name, version]) => actual[name]?.version === version) ? 0 : 1);' "$installed" && \
    test "$(/usr/sbin/runuser -u agent -- /home/agent/.local/bin/claude --version)" = '2.1.251 (Claude Code)' && test "$(/usr/sbin/runuser -u agent -- /home/agent/.local/bin/codex --version)" = 'codex-cli 0.151.0' && \
    for path in /home/agent/.openhands /home/agent/.claude /home/agent/.codex /home/agent/workspaces; do test "$(/usr/bin/stat -c '%U:%G %a' "$path")" = 'agent:agent 700'; done && \
    /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get update && \
    /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y --no-install-recommends openssl && \
    /usr/bin/openssl req -x509 -newkey rsa:2048 -nodes -keyout /etc/nginx/tls/tls.key -out /etc/nginx/tls/tls.crt -subj /CN=localhost -days 1 && \
    /usr/sbin/nginx -t && /usr/bin/rm -f /etc/nginx/tls/tls.crt /etc/nginx/tls/tls.key && \
    test ! -e /etc/nginx/tls/tls.key && /usr/bin/rm -rf /var/lib/apt/lists/*

RUN /usr/sbin/runuser -u agent -- /usr/bin/env -i HOME=/home/agent PATH=/usr/local/bin:/usr/bin:/bin \
      /usr/local/bin/node /opt/openhands-build/agent-canvas-ingress-smoke.mjs /home/agent/.local/lib/node_modules/@openhands/agent-canvas/scripts/ingress.mjs

FROM provisioned AS wsl

COPY --chown=root:root worker/rootfs-wsl/ /
RUN /usr/bin/chmod 0755 /usr/local/sbin/openhands-overlay && \
    /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get update && \
    /usr/bin/env -i PATH=/usr/sbin:/usr/bin:/sbin:/bin DEBIAN_FRONTEND=noninteractive /usr/bin/apt-get install -y --no-install-recommends systemd systemd-sysv libpam-systemd dbus-user-session locales && \
    /usr/sbin/locale-gen en_US.UTF-8 C.UTF-8 && /usr/sbin/update-locale LANG=en_US.UTF-8 && \
    /usr/bin/rm -f /etc/systemd/system/multi-user.target.wants/nginx.service && \
    test -x /sbin/init && test -x /usr/bin/systemctl && \
    test ! -e /etc/systemd/system/multi-user.target.wants/nginx.service && \
    /usr/bin/rm -rf /var/lib/apt/lists/*

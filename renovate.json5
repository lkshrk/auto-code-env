{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "git-submodules": {
    "enabled": true,
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned as Terraform variable defaults in Coder modules",
      "managerFilePatterns": ["/^coder/modules/.+\\.tf$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  "packageRules": [
    {
      "description": "OpenCode workspace servers must match the control plane (h-cloud) and the benchmark (coding-harness); bump all three together",
      "matchDepNames": ["opencode-ai"],
      "automerge": false,
      "labels": ["opencode-version"],
    },
    {
      "description": "docker:28+ dind (runc 1.5) crashes the Talos kernel on inner container start; stay on 27",
      "matchDepNames": ["docker"],
      "allowedVersions": "<28",
    },
    {
      "matchManagers": ["git-submodules"],
      "matchPackageNames": ["https://github.com/OpenHands/OpenHands.git"],
      "versioning": "semver",
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
    },
  ],
}

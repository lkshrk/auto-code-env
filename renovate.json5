{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": ["config:recommended"],
  "git-submodules": {
    "enabled": true,
  },
  "customManagers": [
    {
      "customType": "regex",
      "description": "Versions pinned as Terraform variable defaults in Coder modules",
      "managerFilePatterns": ["/^coder/modules/.+\\.tf$/"],
      "matchStrings": [
        "# renovate: datasource=(?<datasource>\\S+) depName=(?<depName>\\S+)\\n\\s*default\\s*=\\s*\"(?<currentValue>[^\"]+)\"",
      ],
    },
  ],
  "packageRules": [
    {
      "description": "OpenCode v2 worker releases change the ACP and config surface; review each bump",
      "matchDepNames": ["@opencode/cli-linux-x64"],
      "automerge": false,
      "labels": ["opencode-version"],
    },
    {
      "description": "rtk tags releases as v<version>; the module pins the bare version",
      "matchDepNames": ["rtk-ai/rtk"],
      "extractVersion": "^v(?<version>.+)$",
    },
    {
      "description": "Tools every OpenCode session uses change agent behaviour; review each bump",
      "matchDepNames": ["rtk-ai/rtk", "context-mode", "codegraphcontext"],
      "automerge": false,
      "labels": ["opencode-version"],
    },
    {
      "description": "docker:28+ dind (runc 1.5) crashes the Talos kernel on inner container start; stay on 27",
      "matchDepNames": ["docker"],
      "allowedVersions": "<28",
    },
    {
      "matchManagers": ["git-submodules"],
      "matchPackageNames": ["https://github.com/OpenHands/OpenHands.git"],
      "versioning": "semver",
      "allowedVersions": "/^v\\d+\\.\\d+\\.\\d+$/",
      "automerge": true,
      "automergeType": "pr",
      "platformAutomerge": false,
    },
  ],
}

# .gitignore for auto-code-env
# Never commit secrets. This repo stores only secret references.

*.env
.env.*
!.env.example
*.pem
*.key
secrets/
.DS_Store
.agent-progress.md
__pycache__/
*.py[cod]

# Terraform local state/provider cache - never commit.
**/.terraform/
*.tfstate
*.tfstate.*
.terraform.lock.hcl

# Agent/AI session state
.omx/
.omc/
.claude/
.codex/
.agents/
.wolf/
.superpowers/
.taskless/
.agent-progress.md
docs/superpowers/
docs/handover/

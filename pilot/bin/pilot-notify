#!/usr/bin/env bash
# Posts a plain message to the Pilot Telegram group.
# Usage: pilot-notify "<message>"
set -euo pipefail

token="${TELEGRAM_BOT_TOKEN:?TELEGRAM_BOT_TOKEN is required}"
chat="${TELEGRAM_CHAT_ID:?TELEGRAM_CHAT_ID is required}"
msg="${1:-}"
[[ -n "$msg" ]] || {
  echo "usage: pilot-notify <message>" >&2
  exit 2
}

python3 - "$token" "$chat" "$msg" "${TELEGRAM_TOPIC_ID:-}" <<'PY'
import json, sys, urllib.request
token, chat, text, topic = sys.argv[1], sys.argv[2], sys.argv[3], sys.argv[4]
payload = {"chat_id": chat, "text": text}
if topic.strip() not in ("", "0"):
    payload["message_thread_id"] = int(topic)
req = urllib.request.Request(
    f"https://api.telegram.org/bot{token}/sendMessage",
    data=json.dumps(payload).encode(),
    headers={"Content-Type": "application/json"})
with urllib.request.urlopen(req, timeout=15) as r:
    print("sent" if json.load(r).get("ok") else "failed")
PY

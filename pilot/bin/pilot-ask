#!/usr/bin/env bash
# Posts a blocking question from a Pilot run to the Telegram group.
# Usage: pilot-ask "<issue-id>" "<question>"
set -euo pipefail

issue="${1:-unknown}"
question="${2:-}"

if [[ -z "$question" ]]; then
  echo "usage: pilot-ask <issue-id> <question>" >&2
  exit 2
fi

printf -v text '❓ Pilot is blocked on %s\n\n%s\n\nReply here with the answer as an instruction, starting with the issue id — e.g. "%s: <decision>" — then tap Execute on the confirmation (it expires after 5 min). The answer gets written back to the Linear issue.\n\nTo re-run the original ticket verbatim instead: pilot-retry %s' \
  "$issue" "$question" "$issue" "$issue"

exec "$(dirname "$0")/pilot-notify" "$text"

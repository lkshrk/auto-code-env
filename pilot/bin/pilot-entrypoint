#!/usr/bin/env bash
# Creates writable home paths, seeds project checkouts, then hands off to Pilot.
set -euo pipefail

mkdir -p \
  "$HOME/tmp" \
  "$HOME/repos" \
  "$HOME/.pilot/data" \
  "$HOME/.cache" \
  "$HOME/.local/share"

if [[ -n "${PILOT_CLONE_REPOS:-}" ]]; then
  PILOT_GIT_TOKEN="${GITHUB_TOKEN:?GITHUB_TOKEN is required to clone}"
  export PILOT_GIT_TOKEN
  helper='!f(){ echo username=x-access-token; echo password=$PILOT_GIT_TOKEN; };f'

  for slug in ${PILOT_CLONE_REPOS//,/ }; do
    dest="$HOME/repos/$slug"
    [[ -d "$dest/.git" ]] && continue
    mkdir -p "$(dirname "$dest")"
    echo "pilot-entrypoint: cloning $slug into $dest"
    git -c "credential.helper=$helper" clone --quiet "https://github.com/${slug}.git" "$dest"
  done

  unset PILOT_GIT_TOKEN
fi

exec /usr/local/bin/pilot "$@"

#!/usr/bin/env bash
# Shim: guards the identity PRs are opened under, and announces created PRs.
set -euo pipefail

REAL_GH="${REAL_GH:-/usr/bin/gh}"
BIN_DIR="$(dirname "$0")"
EXPECTED_LOGIN="${PILOT_GH_LOGIN:-}"

if [[ -z "${GH_TOKEN:-}" && -z "${GITHUB_TOKEN:-}" ]]; then
  printf 'gh-shim: no GH_TOKEN/GITHUB_TOKEN in environment; refusing to run unauthenticated\n' >&2
  exit 1
fi
export GH_TOKEN="${GH_TOKEN:-${GITHUB_TOKEN}}"
export GITHUB_TOKEN="$GH_TOKEN"

is_pr_create=0
skip_value=0
path=()
for arg in "$@"; do
  if ((skip_value)); then
    skip_value=0
    continue
  fi
  case "$arg" in
    --repo|--hostname|-R) skip_value=1 ;;
    --repo=*|--hostname=*|-R=*) ;;
    -*) ;;
    *) path+=("$arg") ;;
  esac
done
[[ "${path[0]:-}" == pr && "${path[1]:-}" == create ]] && is_pr_create=1

if ((is_pr_create)); then
  if [[ -n "$EXPECTED_LOGIN" ]]; then
    actual=$("$REAL_GH" api user --jq .login 2>/dev/null || true)
    if [[ "$actual" != "$EXPECTED_LOGIN" ]]; then
      printf 'gh-shim: authenticated as %q, expected %q; refusing to open a PR that could not be approved\n' \
        "$actual" "$EXPECTED_LOGIN" >&2
      exit 1
    fi
  fi

  set +e
  out=$("$REAL_GH" "$@" 2>&1)
  rc=$?
  set -e
  printf '%s\n' "$out"
  url=$(printf '%s' "$out" | grep -oE 'https://github\.com/[^[:space:]]+/pull/[0-9]+' | head -1)
  if [[ $rc -eq 0 && -n "$url" ]]; then
    meta=$("$REAL_GH" pr view "$url" --json title,headRefName,additions,deletions,changedFiles,files,body 2>/dev/null || echo '{}')
    msg=$(printf '%s' "$meta" | python3 "$BIN_DIR/pr-summary.py" "$url" 2>/dev/null || printf '🔀 PR ready for review\n\n%s' "$url")
    "$BIN_DIR/pilot-notify" "$msg" >/dev/null 2>&1 || true
  fi
  exit $rc
fi

exec "$REAL_GH" "$@"

#!/usr/bin/env bash
set -euo pipefail

registry="${DEVBOX_REGISTRY:-ghcr.io/lkshrk/devbox}"
runtime="${DEVBOX_RUNTIME:-docker}"
env_file="${DEVBOX_ENV_FILE:-$HOME/.config/devbox/env}"

usage() {
  cat <<'EOF' >&2
usage: devbox up NAME [--image VARIANT] [-v HOST:CTR]... [-w DIR]
       devbox sh NAME
       devbox run [--image VARIANT] [-v HOST:CTR]... [-w DIR] -- CMD...
       devbox stop NAME | rm NAME | ls

env: DEVBOX_ENV_FILE (default ~/.config/devbox/env)
     DEVBOX_REGISTRY (default ghcr.io/lkshrk/devbox)
     DEVBOX_RUNTIME  (docker|podman, default docker)
EOF
  exit 2
}

check_env_file() {
  [ -f "$env_file" ] || {
    echo "devbox: env file $env_file missing (see scripts/devbox.env.example)" >&2
    exit 1
  }
  local mode
  mode=$(stat -f %Lp "$env_file" 2>/dev/null || stat -c %a "$env_file")
  [ "$mode" = "600" ] || {
    echo "devbox: $env_file must be mode 600 (is $mode)" >&2
    exit 1
  }
}

common_args() {
  common=(--env-file "$env_file")
  [ -n "${SSH_AUTH_SOCK:-}" ] && [ -e "$SSH_AUTH_SOCK" ] || return 0
  case "$(uname -s)" in
    Darwin) common+=(-v /run/host-services/ssh-auth.sock:/ssh-agent) ;;
    *)      common+=(-v "$SSH_AUTH_SOCK:/ssh-agent") ;;
  esac
  common+=(-e SSH_AUTH_SOCK=/ssh-agent)
}

parse_opts() {
  image=full
  opts=()
  while [ $# -gt 0 ]; do
    case "$1" in
      --image) [ -n "${2-}" ] || usage; image="$2"; shift 2 ;;
      -v|-w) [ -n "${2-}" ] || usage; opts+=("$1" "$2"); shift 2 ;;
      --) shift; break ;;
      -*) usage ;;
      *) break ;;
    esac
  done
  rest=("$@")
}

take_name() {
  name="${1:-}"
  [ -n "$name" ] || usage
}

cmd="${1:-}"; shift || usage
case "$cmd" in
  up)
    take_name "${1:-}"; shift
    parse_opts "$@"
    check_env_file
    common_args
    "$runtime" run -d --name "devbox-$name" -v "devbox-$name-home:/home/dev" \
      "${common[@]}" ${opts[@]+"${opts[@]}"} "$registry/$image:latest"
    ;;
  sh)
    take_name "${1:-}"
    "$runtime" exec -it "devbox-$name" zsh -l
    ;;
  run)
    parse_opts "$@"
    [ ${#rest[@]} -gt 0 ] || usage
    check_env_file
    common_args
    "$runtime" run --rm -it \
      "${common[@]}" ${opts[@]+"${opts[@]}"} "$registry/$image:latest" "${rest[@]}"
    ;;
  stop)
    take_name "${1:-}"
    "$runtime" stop "devbox-$name"
    ;;
  rm)
    take_name "${1:-}"
    read -r -p "delete container devbox-$name and its home volume? [y/N] " ans
    [ "$ans" = y ] || exit 0
    "$runtime" rm -f "devbox-$name"
    "$runtime" volume rm "devbox-$name-home"
    ;;
  ls)
    "$runtime" ps -a --filter name=^devbox- --format '{{.Names}}\t{{.Status}}\t{{.Image}}'
    ;;
  *) usage ;;
esac
